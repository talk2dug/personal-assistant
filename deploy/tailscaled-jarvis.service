[Unit]
Description=Tailscale node agent (Jarvis, independent identity)
Documentation=https://tailscale.com/kb/
Wants=network-pre.target
After=network-pre.target NetworkManager.service systemd-resolved.service

[Service]
ExecStart=/usr/sbin/tailscaled --state=/var/lib/tailscale-jarvis/tailscaled.state --socket=/run/tailscale-jarvis/tailscaled.sock --port=41642 --tun=tailscale1
ExecStopPost=/usr/sbin/tailscaled --cleanup --state=/var/lib/tailscale-jarvis/tailscaled.state --socket=/run/tailscale-jarvis/tailscaled.sock

Restart=on-failure

RuntimeDirectory=tailscale-jarvis
RuntimeDirectoryMode=0755
StateDirectory=tailscale-jarvis
StateDirectoryMode=0700
CacheDirectory=tailscale-jarvis
CacheDirectoryMode=0750
Type=notify

[Install]
WantedBy=multi-user.target
