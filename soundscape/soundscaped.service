[Unit]
Description=Generative ambient soundscape (Snapcast pipe source)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=soundscape
Group=soundscape
SupplementaryGroups=audio

# RuntimeDirectory puts the FIFO in /run/soundscape, owned by this service, and cleans
# it up on stop. It must NOT live in /tmp: modern kernels set fs.protected_fifos=1, and
# snapserver then silently fails to open a FIFO in a world-writable directory. The
# symptom is total silence with no error logged anywhere, which is a miserable hour.
RuntimeDirectory=soundscape
RuntimeDirectoryMode=0755

WorkingDirectory=/opt/soundscape
ExecStart=/usr/bin/python3 /opt/soundscape/soundscaped.py \
    --fifo /run/soundscape/ambient \
    --presets /opt/soundscape/presets \
    --sounds /opt/soundscape/sounds \
    --port 8099

Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

# It only ever reads its own sample library and writes one FIFO.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/soundscape

[Install]
WantedBy=multi-user.target
