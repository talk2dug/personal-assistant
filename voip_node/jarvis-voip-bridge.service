# NOT installed/enabled on purpose -- the main session launches the bridge by hand
# for the attended live call. To install later:
#   sudo cp ~/voip-bridge/jarvis-voip-bridge.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now jarvis-voip-bridge
[Unit]
Description=Jarvis VoIP audio bridge (baresip <-> JarvisWeb /turn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
ExecStartPre=/sbin/modprobe snd-aloop
ExecStart=/usr/bin/python3 -u /home/pi/voip-bridge/bridge.py
Restart=no

[Install]
WantedBy=multi-user.target
